<form class="{{cssClass}} flexcol" autocomplete="off">
  
  <!-- PARTE SUPERIOR -->
  <header class="sheet-header main-grid">
    <!-- FOTO FACHERA -->
    <div class="portrait-container">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    </div>
    
    <!-- Nombre del personaje y demas -->
    <div class="header-details">
      <div class="name-row">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Nombre del personaje"/>
      </div>
      
      <div class="stats-top-row flexrow">
        
        <!-- SECCION 1: Destino & Albedrio -->
        <div class="header-block recursos-block">
          <div class="flexrow">
            <div class="resource-col">
              <label>Destino</label>
              <div class="resource-square">
                <input class="max-circle" type="number" name="system.recursos.destino.max" value="{{system.recursos.destino.max}}" title="Max Destino">
                <span class="current-val">{{system.recursos.destino.value}}</span>
              </div>
              <div class="btn-group">
                <a class="adj-btn" data-target="system.recursos.destino.value" data-dir="-1"><i class="fas fa-minus-circle"></i></a>
                <a class="adj-btn" data-target="system.recursos.destino.value" data-dir="1"><i class="fas fa-plus-circle"></i></a>
              </div>
            </div>
            <div class="resource-col">
              <label>Albedrío</label>
              <div class="resource-square">
                <input class="max-circle" type="number" name="system.recursos.albedrio.max" value="{{system.recursos.albedrio.max}}" title="Max Albedrío">
                <span class="current-val">{{system.recursos.albedrio.value}}</span>
              </div>
              <div class="btn-group">
                <a class="adj-btn" data-target="system.recursos.albedrio.value" data-dir="-1"><i class="fas fa-minus-circle"></i></a>
                <a class="adj-btn" data-target="system.recursos.albedrio.value" data-dir="1"><i class="fas fa-plus-circle"></i></a>
              </div>
            </div>
          </div>
          <div class="explosiones-row">
            <label>Explosiones naturales</label>
            <input type="number" name="system.recursos.explosiones" value="{{system.recursos.explosiones}}">
          </div>
        </div>

        <!-- SECCION 2: Daño -->
        <div class="header-block dano-block">
          <label class="block-title">Daño</label>
          <div class="health-bar-container">
            <div class="health-bar">
              <div class="health-fill damage" style="width: {{barras.danoPct}}%"></div>
              <div class="health-fill wounds" style="width: {{barras.heridasPct}}%; right: 0; left: auto; background: #333;"></div>
            </div>
          </div>
          <div class="dano-stats flexrow">
            <div class="dano-col">
              <div class="stat-row"><label>Aguante</label> <input type="number" name="system.combate.aguante" value="{{system.combate.aguante}}"></div>
              <div class="stat-row"><label>Absorción</label> <input type="number" name="system.combate.absorcion" value="{{system.combate.absorcion}}"></div>
            </div>
            <div class="dano-col">
              <label>Recibido</label> <input class="big-input" type="number" name="system.combate.recibido" value="{{system.combate.recibido}}">
            </div>
            <div class="dano-col right-col">
              <label>Heridas</label>
              <input type="number" class="big-input" name="system.combate.heridas" value="{{system.combate.heridas}}">
            </div>
          </div>
        </div>

        <!-- SECCION 3: Defensa y Movimiento -->
        <div class="header-block defensa-block">
          <div class="defensa-header flexrow">
            <label class="block-title">Defensa</label>
            <div class="def-inputs">
              <input type="number" name="system.combate.defensa.base1" value="{{system.combate.defensa.base1}}"> + 
              <input type="number" name="system.combate.defensa.base2" value="{{system.combate.defensa.base2}}">
            </div>
          </div>
          <div class="defensa-mid flexrow">
            <div class="def-box"><label>Pasiva</label><div class="readonly-box">{{system.derived.defensa.pasiva}}</div></div>
            <div class="def-box"><label>Bono</label><input type="number" name="system.combate.defensa.bono" value="{{system.combate.defensa.bono}}"></div>
          </div>
          <div class="defensa-activa">
             <div class="activa-row"><span>Acción</span></div>
             <div class="activa-row"><label>Activa</label> <button class="tipo-accion" type="button">Med.</button> <button type="button" class="tipo-accion">Com.</button></div>
             <div class="activa-row mt-1"><label>Total</label> <button type="button" class="tipo-accion">Med.</button> <button type="button" class="tipo-accion">Com.</button></div>
          </div>
          <div class="movimiento-row">
            <label class="block-title">Movimiento</label>
            <input type="number" name="system.combate.movimiento" value="{{system.combate.movimiento}}">
          </div>
        </div>

        <!-- SECCION 4: Turno -->
        <div class="header-block turno-block">
          <div class="turno-header flexrow">
            <label class="block-title">Turno</label>
            <select name="system.combate.turno.tipo">
              {{selectOptions opcionesTurno selected=system.combate.turno.tipo}}
            </select>
          </div>
          <div class="turno-bono">
            <label>Bono</label>
            <input type="number" name="system.combate.turno.bono" value="{{system.combate.turno.bono}}">
          </div>
          <div class="turno-dice">
            {{#each system.combate.turno.dados as |val key|}}
            <div class="dice-row">
              <a class="adj-btn" data-target="system.combate.turno.dados.{{key}}" data-dir="-1"><i class="fas fa-minus-circle"></i></a>
              <span class="dice-icon">{{key}}</span>
              <span class="dice-val">{{val}}</span>
              <a class="adj-btn" data-target="system.combate.turno.dados.{{key}}" data-dir="1"><i class="fas fa-plus-circle"></i></a>
            </div>
            {{/each}}
          </div>
          <div class="turno-actions flexrow">
            <div class="action-btn-group">
              <a class="adj-btn" data-target="system.combate.turno.puntos" data-dir="-1" data-step="1" data-max="4" title="-1"><i class="fas fa-minus-circle big-btn"></i></a>
              <a class="adj-btn" data-target="system.combate.turno.puntos" data-dir="-1" data-step="0.5" data-max="4" title="-0.5"><i class="fas fa-minus small-btn"></i></a>
            </div>
            
            <div class="action-circles">
              {{#each circulosTurno as |estado|}}
                <div class="turno-circle {{estado}}"></div>
              {{/each}}
            </div>

            <div class="action-btn-group">
              <a class="adj-btn" data-target="system.combate.turno.puntos" data-dir="1" data-step="0.5" data-max="4" title="+0.5"><i class="fas fa-plus small-btn"></i></a>
              <a class="adj-btn" data-target="system.combate.turno.puntos" data-dir="1" data-step="1" data-max="4" title="+1"><i class="fas fa-plus-circle big-btn"></i></a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- NAVEGACION (Las secciones) -->
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item active" data-tab="principal">Principal</a>
    <a class="item" data-tab="biografia">Biografía</a>
    <a class="item" data-tab="inventario">Inventario</a>
    <a class="item" data-tab="experiencia">Experiencia</a>
    <a class="item" data-tab="dotes">Dotes</a>
    <a class="item options-btn" data-tab="opciones"><i class="fas fa-cog"></i></a>
  </nav>

  <!-- NAVEGACION GENERAL -->
  <section class="sheet-body">
    
    <!-- NAVEGACION: PRINCIPAL -->
    <div class="tab principal main-layout flexrow" data-group="primary" data-tab="principal">
      
      <!-- Stats -->
      <aside class="sidebar-stats">
        <!-- Grupo 1 -->
        <div class="stat-pair flexrow">
          <div class="stat-box"><label><a class="rollable-stat" data-stat="fortaleza">Fortaleza</a></label><input type="number" name="system.attributes.fortaleza" value="{{system.attributes.fortaleza}}"></div>
          <div class="stat-box"><label><a class="rollable-stat" data-stat="destreza">Destreza</a></label><input type="number" name="system.attributes.destreza" value="{{system.attributes.destreza}}"></div>
        </div>
        <div class="stat-bar-container">
          <label>Estamina</label>
          <div class="flexrow align-center">
            <div class="resource-bar estamina-bg">x / {{system.derived.estamina.max}}</div>
            <div class="bono-box"><label>Bono</label><input type="number" name="system.bonos.estamina" value="{{system.bonos.estamina}}"></div>
          </div>
        </div>

        <hr>

        <!-- Grupo 2 -->
        <div class="stat-pair flexrow">
          <div class="stat-box"><label><a class="rollable-stat" data-stat="intelecto">Intelecto</a></label><input type="number" name="system.attributes.intelecto" value="{{system.attributes.intelecto}}"></div>
          <div class="stat-box"><label><a class="rollable-stat" data-stat="carisma">Carisma</a></label><input type="number" name="system.attributes.carisma" value="{{system.attributes.carisma}}"></div>
        </div>
        <div class="stat-bar-container">
          <label>Compostura</label>
          <div class="flexrow align-center">
            <div class="resource-bar compostura-bg">x / {{system.derived.compostura.max}}</div>
            <div class="bono-box"><label>Bono</label><input type="number" name="system.bonos.compostura" value="{{system.bonos.compostura}}"></div>
          </div>
        </div>

        <hr>

        <!-- Grupo 3 -->
        <div class="stat-pair flexrow">
          <div class="stat-box"><label><a class="rollable-stat" data-stat="afinidad">Afinidad</a></label><input type="number" name="system.attributes.afinidad" value="{{system.attributes.afinidad}}"></div>
          <div class="stat-box"><label><a class="rollable-stat" data-stat="voluntad">Voluntad</a></label><input type="number" name="system.attributes.voluntad" value="{{system.attributes.voluntad}}"></div>
        </div>
        <div class="stat-bar-container">
          <label>Poder</label>
          <div class="flexrow align-center">
            <div class="resource-bar poder-bg">x / {{system.derived.poder.max}}</div>
            <div class="bono-box"><label>Bono</label><input type="number" name="system.bonos.poder" value="{{system.bonos.poder}}"></div>
          </div>
        </div>
      </aside>

      <!-- SKILLS -->
      <section class="skills-section">
        
        <!-- Grupo 1 -->
        <div class="skills-grid">
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="pelea"></a> <label>Pelea</label> <input type="number" name="system.skills.pelea" value="{{system.skills.pelea}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="atletismo"></a> <label>Atletismo</label> <input type="number" name="system.skills.atletismo" value="{{system.skills.atletismo}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="sigilo"></a> <label>Sigilo</label> <input type="number" name="system.skills.sigilo" value="{{system.skills.sigilo}}"></div>
          
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="disparo"></a> <label>Disparo</label> <input type="number" name="system.skills.disparo" value="{{system.skills.disparo}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="acrobacia"></a> <label>Acrobacia</label> <input type="number" name="system.skills.acrobacia" value="{{system.skills.acrobacia}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="latrocinio"></a> <label>Latrocinio</label> <input type="number" name="system.skills.latrocinio" value="{{system.skills.latrocinio}}"></div>
          
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="resistencia"></a> <label>Resistencia</label> <input type="number" name="system.skills.resistencia" value="{{system.skills.resistencia}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="proeza"></a> <label>Proeza</label> <input type="number" name="system.skills.proeza" value="{{system.skills.proeza}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="conducir"></a> <label>Conducción</label> <input type="number" name="system.skills.conducir" value="{{system.skills.conducir}}"></div>
        </div>

        <hr class="skill-divider">

        <!-- Grupo 2 -->
        <div class="skills-grid">
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="percepcion"></a> <label>Percepción</label> <input type="number" name="system.skills.percepcion" value="{{system.skills.percepcion}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="influencia"></a> <label>Persuasión</label> <input type="number" name="system.skills.influencia" value="{{system.skills.influencia}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="cultura"></a> <label>Cultura</label> <input type="number" name="system.skills.cultura" value="{{system.skills.cultura}}"></div>
          
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="investigacion"></a> <label>Investigación</label> <input type="number" name="system.skills.investigacion" value="{{system.skills.investigacion}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="subterfugio"></a> <label>Subterfugio</label> <input type="number" name="system.skills.subterfugio" value="{{system.skills.subterfugio}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="ciencia"></a> <label>Ciencia</label> <input type="number" name="system.skills.ciencia" value="{{system.skills.ciencia}}"></div>
          
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="resilencia"></a> <label>Resilencia</label> <input type="number" name="system.skills.resilencia" value="{{system.skills.resilencia}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="elaborar"></a> <label>Elaborar</label> <input type="number" name="system.skills.elaborar" value="{{system.skills.elaborar}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="medicina"></a> <label>Medicina</label> <input type="number" name="system.skills.medicina" value="{{system.skills.medicina}}"></div>
        </div>

        <hr class="skill-divider">

        <!-- Grupo 3 -->
        <div class="skills-grid">
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="ocultismo"></a> <label>Ocultismo</label> <input type="number" name="system.skills.ocultismo" value="{{system.skills.ocultismo}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="canalizar"></a> <label>Canalización</label> <input type="number" name="system.skills.canalizar" value="{{system.skills.canalizar}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="presencia"></a> <label>Presencia</label> <input type="number" name="system.skills.presencia" value="{{system.skills.presencia}}"></div>
          
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="espiritualidad"></a> <label>Espiritualidad</label> <input type="number" name="system.skills.espiritualidad" value="{{system.skills.espiritualidad}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="naturaleza"></a> <label>Naturaleza</label> <input type="number" name="system.skills.naturaleza" value="{{system.skills.naturaleza}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="arte"></a> <label>Arte</label> <input type="number" name="system.skills.arte" value="{{system.skills.arte}}"></div>
          
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="ataraxia"></a> <label>Ataraxia</label> <input type="number" name="system.skills.ataraxia" value="{{system.skills.ataraxia}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="instinto"></a> <label>Instinto</label> <input type="number" name="system.skills.instinto" value="{{system.skills.instinto}}"></div>
          <div class="skill-item"><a class="rollable-skill roll-btn" data-skill="actuacion"></a> <label>Actuación</label> <input type="number" name="system.skills.actuacion" value="{{system.skills.actuacion}}"></div>
        </div>

      </section>
    </div>

    <!-- NAVEGACION: las demas pero vacias -->
    <div class="tab" data-group="primary" data-tab="biografia"><p>Biografía lore ipsum...</p></div>
    <div class="tab" data-group="primary" data-tab="inventario"><p>Inventario lore ipsum...</p></div>
    <div class="tab" data-group="primary" data-tab="experiencia"><p>Experiencia lore ipsum...</p></div>
    <div class="tab" data-group="primary" data-tab="dotes"><p>Dotes lore ipsum...</p></div>
    <div class="tab" data-group="primary" data-tab="opciones"><p>Configuración del sistema lore ipsum...</p></div>
  </section>
</form>
