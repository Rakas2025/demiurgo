<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <h1><input name="name" type="text" value="{{actor.name}}" placeholder="Nombre del personaje"/></h1>
  </header>

  <section class="sheet-body">
    <!-- ATRIBUTOS Y STATS -->
    <div class="group-container">
      <h3>Grupo 1: Cuerpo</h3>
      <div class="flexrow">
        <label><a class="rollable-stat" data-stat="fortaleza"><i class="fas fa-dice"></i> Fortaleza</a> <input type="number" name="system.attributes.fortaleza" value="{{system.attributes.fortaleza}}" min="-5" max="30"/></label>
        <label><a class="rollable-stat" data-stat="destreza"><i class="fas fa-dice"></i> Destreza</a> <input type="number" name="system.attributes.destreza" value="{{system.attributes.destreza}}" min="-5" max="30"/></label>
        <p><strong>Estamina:</strong> {{system.derived.estamina}}</p>
      </div>
      
      <h3>Grupo 2: Mente</h3>
      <div class="flexrow">
        <label><a class="rollable-stat" data-stat="intelecto"><i class="fas fa-dice"></i> Intelecto</a> <input type="number" name="system.attributes.intelecto" value="{{system.attributes.intelecto}}" min="-5" max="30"/></label>
        <label><a class="rollable-stat" data-stat="carisma"><i class="fas fa-dice"></i> Carisma</a> <input type="number" name="system.attributes.carisma" value="{{system.attributes.carisma}}" min="-5" max="30"/></label>
        <p><strong>Compostura:</strong> {{system.derived.compostura}}</p>
      </div>

      <h3>Grupo 3: Alma</h3>
      <div class="flexrow">
        <label><a class="rollable-stat" data-stat="afinidad"><i class="fas fa-dice"></i> Afinidad</a> <input type="number" name="system.attributes.afinidad" value="{{system.attributes.afinidad}}" min="-5" max="30"/></label>
        <label><a class="rollable-stat" data-stat="voluntad"><i class="fas fa-dice"></i> Voluntad</a> <input type="number" name="system.attributes.voluntad" value="{{system.attributes.voluntad}}" min="-5" max="30"/></label>
        <p><strong>Poder:</strong> {{system.derived.poder}}</p>
      </div>
    </div>

    <hr>

    <!-- SKILLS -->
    
    <h3>Habilidades de Cuerpo</h3>
    <div class="grid grid-3col">
      <label><a class="rollable-skill" data-skill="pelea"><i class="fas fa-dice"></i> Pelea</a> <input type="number" name="system.skills.pelea" value="{{system.skills.pelea}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="disparo"><i class="fas fa-dice"></i> Disparo</a> <input type="number" name="system.skills.disparo" value="{{system.skills.disparo}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="atletismo"><i class="fas fa-dice"></i> Atletismo</a> <input type="number" name="system.skills.atletismo" value="{{system.skills.atletismo}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="acrobacia"><i class="fas fa-dice"></i> Acrobacia</a> <input type="number" name="system.skills.acrobacia" value="{{system.skills.acrobacia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="proeza"><i class="fas fa-dice"></i> Proeza</a> <input type="number" name="system.skills.proeza" value="{{system.skills.proeza}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="resistencia"><i class="fas fa-dice"></i> Resistencia</a> <input type="number" name="system.skills.resistencia" value="{{system.skills.resistencia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="sigilo"><i class="fas fa-dice"></i> Sigilo</a> <input type="number" name="system.skills.sigilo" value="{{system.skills.sigilo}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="latrocinio"><i class="fas fa-dice"></i> Latrocinio</a> <input type="number" name="system.skills.latrocinio" value="{{system.skills.latrocinio}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="conducir"><i class="fas fa-dice"></i> Conducir</a> <input type="number" name="system.skills.conducir" value="{{system.skills.conducir}}" min="-5" max="30"/></label>
    </div>

    <h3>Habilidades de Mente</h3>
    <div class="grid grid-3col">
      <label><a class="rollable-skill" data-skill="percepcion"><i class="fas fa-dice"></i> Percepcion</a> <input type="number" name="system.skills.percepcion" value="{{system.skills.percepcion}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="influencia"><i class="fas fa-dice"></i> Influencia</a> <input type="number" name="system.skills.influencia" value="{{system.skills.influencia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="resilencia"><i class="fas fa-dice"></i> Resilencia</a> <input type="number" name="system.skills.resilencia" value="{{system.skills.resilencia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="subterfugio"><i class="fas fa-dice"></i> Subterfugio</a> <input type="number" name="system.skills.subterfugio" value="{{system.skills.subterfugio}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="elaborar"><i class="fas fa-dice"></i> Elaborar</a> <input type="number" name="system.skills.elaborar" value="{{system.skills.elaborar}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="investigacion"><i class="fas fa-dice"></i> Investigacion</a> <input type="number" name="system.skills.investigacion" value="{{system.skills.investigacion}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="ciencia"><i class="fas fa-dice"></i> Ciencia</a> <input type="number" name="system.skills.ciencia" value="{{system.skills.ciencia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="medicina"><i class="fas fa-dice"></i> Medicina</a> <input type="number" name="system.skills.medicina" value="{{system.skills.medicina}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="cultura"><i class="fas fa-dice"></i> Cultura</a> <input type="number" name="system.skills.cultura" value="{{system.skills.cultura}}" min="-5" max="30"/></label>
    </div>

    <h3>Habilidades de Alma</h3>
    <div class="grid grid-3col">
      <label><a class="rollable-skill" data-skill="ocultismo"><i class="fas fa-dice"></i> Ocultismo</a> <input type="number" name="system.skills.ocultismo" value="{{system.skills.ocultismo}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="espiritualidad"><i class="fas fa-dice"></i> Espiritualidad</a> <input type="number" name="system.skills.espiritualidad" value="{{system.skills.espiritualidad}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="canalizar"><i class="fas fa-dice"></i> Canalizar</a> <input type="number" name="system.skills.canalizar" value="{{system.skills.canalizar}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="naturaleza"><i class="fas fa-dice"></i> Naturaleza</a> <input type="number" name="system.skills.naturaleza" value="{{system.skills.naturaleza}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="presencia"><i class="fas fa-dice"></i> Presencia</a> <input type="number" name="system.skills.presencia" value="{{system.skills.presencia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="arte"><i class="fas fa-dice"></i> Arte</a> <input type="number" name="system.skills.arte" value="{{system.skills.arte}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="actuacion"><i class="fas fa-dice"></i> Actuacion</a> <input type="number" name="system.skills.actuacion" value="{{system.skills.actuacion}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="ataraxia"><i class="fas fa-dice"></i> Ataraxia</a> <input type="number" name="system.skills.ataraxia" value="{{system.skills.ataraxia}}" min="-5" max="30"/></label>
      <label><a class="rollable-skill" data-skill="instinto"><i class="fas fa-dice"></i> Instinto</a> <input type="number" name="system.skills.instinto" value="{{system.skills.instinto}}" min="-5" max="30"/></label>
    </div>
  </section>
</form>
