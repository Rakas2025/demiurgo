<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <h1><input name="name" type="text" value="{{actor.name}}" placeholder="Nombre del personaje"/></h1>
  </header>

  <section class="sheet-body">
    <!-- ATRIBUTOS Y STATS -->
    <div class="group-container">
      <h3>Grupo 1: Cuerpo</h3>
      <div class="flexrow">
        <label>Fortaleza: <input type="number" name="system.attributes.fortaleza" value="{{system.attributes.fortaleza}}" min="-5" max="30"/></label>
        <label>Destreza: <input type="number" name="system.attributes.destreza" value="{{system.attributes.destreza}}" min="-5" max="30"/></label>
        <p><strong>Estamina:</strong> {{system.derived.estamina}}</p>
      </div>
      
      <h3>Grupo 2: Mente</h3>
      <div class="flexrow">
        <label>Intelecto: <input type="number" name="system.attributes.intelecto" value="{{system.attributes.intelecto}}" min="-5" max="30"/></label>
        <label>Carisma: <input type="number" name="system.attributes.carisma" value="{{system.attributes.carisma}}" min="-5" max="30"/></label>
        <p><strong>Compostura:</strong> {{system.derived.compostura}}</p>
      </div>

      <h3>Grupo 3: Alma</h3>
      <div class="flexrow">
        <label>Afinidad: <input type="number" name="system.attributes.afinidad" value="{{system.attributes.afinidad}}" min="-5" max="30"/></label>
        <label>Voluntad: <input type="number" name="system.attributes.voluntad" value="{{system.attributes.voluntad}}" min="-5" max="30"/></label>
        <p><strong>Poder:</strong> {{system.derived.poder}}</p>
      </div>
    </div>

    <hr>

    <!-- SKILLS -->
    
    <h3>Habilidades de Cuerpo</h3>
    <div class="grid grid-3col">
      <label>Pelea: <input type="number" name="system.skills.pelea" value="{{system.skills.pelea}}" min="-5" max="30"/></label>
      <label>Disparo: <input type="number" name="system.skills.disparo" value="{{system.skills.disparo}}" min="-5" max="30"/></label>
      <label>Atletismo: <input type="number" name="system.skills.atletismo" value="{{system.skills.atletismo}}" min="-5" max="30"/></label>
      <label>Acrobacia: <input type="number" name="system.skills.acrobacia" value="{{system.skills.acrobacia}}" min="-5" max="30"/></label>
      <label>Proeza: <input type="number" name="system.skills.proeza" value="{{system.skills.proeza}}" min="-5" max="30"/></label>
      <label>Resistencia: <input type="number" name="system.skills.resistencia" value="{{system.skills.resistencia}}" min="-5" max="30"/></label>
      <label>Sigilo: <input type="number" name="system.skills.sigilo" value="{{system.skills.sigilo}}" min="-5" max="30"/></label>
      <label>Latrocinio: <input type="number" name="system.skills.latrocinio" value="{{system.skills.latrocinio}}" min="-5" max="30"/></label>
      <label>Conducir: <input type="number" name="system.skills.conducir" value="{{system.skills.conducir}}" min="-5" max="30"/></label>
    </div>
    <h3>Habilidades de Mente</h3>
    <div class="grid grid-3col">
      <label>Percepcion: <input type="number" name="system.skills.percepcion" value="{{system.skills.percepcion}}" min="-5" max="30"/></label>
      <label>Influencia: <input type="number" name="system.skills.influencia" value="{{system.skills.influencia}}" min="-5" max="30"/></label>
      <label>Resilencia: <input type="number" name="system.skills.resilencia" value="{{system.skills.resilencia}}" min="-5" max="30"/></label>
      <label>Subterfugio: <input type="number" name="system.skills.subterfugio" value="{{system.skills.subterfugio}}" min="-5" max="30"/></label>
      <label>Elaborar: <input type="number" name="system.skills.elaborar" value="{{system.skills.elaborar}}" min="-5" max="30"/></label>
      <label>Investigacion: <input type="number" name="system.skills.investigacion" value="{{system.skills.investigacion}}" min="-5" max="30"/></label>
      <label>Ciencia: <input type="number" name="system.skills.ciencia" value="{{system.skills.ciencia}}" min="-5" max="30"/></label>
      <label>Medicina: <input type="number" name="system.skills.medicina" value="{{system.skills.medicina}}" min="-5" max="30"/></label>
      <label>Cultura: <input type="number" name="system.skills.cultura" value="{{system.skills.cultura}}" min="-5" max="30"/></label>
    </div>
    <h3>Habilidades de Alma</h3>
    <div class="grid grid-3col">
      <label>Ocultismo: <input type="number" name="system.skills.melee" value="{{system.skills.melee}}" min="-5" max="30"/></label>
      <label>Espiritualidad: <input type="number" name="system.skills.disparo" value="{{system.skills.disparo}}" min="-5" max="30"/></label>
      <label>Canalizar: <input type="number" name="system.skills.atletismo" value="{{system.skills.atletismo}}" min="-5" max="30"/></label>
      <label>Naturaleza: <input type="number" name="system.skills.acrobacia" value="{{system.skills.acrobacia}}" min="-5" max="30"/></label>
      <label>Presencia: <input type="number" name="system.skills.proeza" value="{{system.skills.proeza}}" min="-5" max="30"/></label>
      <label>Arte: <input type="number" name="system.skills.resistencia" value="{{system.skills.resistencia}}" min="-5" max="30"/></label>
      <label>Actuacion: <input type="number" name="system.skills.sigilo" value="{{system.skills.sigilo}}" min="-5" max="30"/></label>
      <label>Ataraxia: <input type="number" name="system.skills.latrocinio" value="{{system.skills.latrocinio}}" min="-5" max="30"/></label>
      <label>Instinto: <input type="number" name="system.skills.conducir" value="{{system.skills.conducir}}" min="-5" max="30"/></label>
    </div>
  </section>
</form>
